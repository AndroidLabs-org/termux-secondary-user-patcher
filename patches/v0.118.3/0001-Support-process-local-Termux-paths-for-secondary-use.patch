diff --git a/app/src/main/java/com/termux/app/SecondaryUserPrefixManager.java b/app/src/main/java/com/termux/app/SecondaryUserPrefixManager.java
new file mode 100644
index 00000000..15266f89
--- /dev/null
+++ b/app/src/main/java/com/termux/app/SecondaryUserPrefixManager.java
@@ -0,0 +1,354 @@
+package com.termux.app;
+
+import android.content.Context;
+import android.os.Build;
+import android.os.Process;
+import android.os.UserManager;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.system.StructStat;
+
+import com.termux.BuildConfig;
+import com.termux.shared.termux.TermuxConstants;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Establishes the process-local path mapping required by Termux's historical hardcoded
+ * {@code /data/data/com.termux} paths when the app runs as a secondary Android user.
+ *
+ * <p>The root helper is deliberately defensive: it asks MagiskSU to enter this app process's
+ * mount namespace, refuses shared/global namespaces, verifies source ownership and inode
+ * identity, and rolls back a newly-created mapping if any postcondition fails.</p>
+ */
+public final class SecondaryUserPrefixManager {
+
+    private static final int ANDROID_UIDS_PER_USER = 100000;
+    private static final int MAX_HELPER_OUTPUT_BYTES = 16 * 1024;
+    private static final long ROOT_HELPER_TIMEOUT_SECONDS = 90L;
+
+    /**
+     * Inode identity alone is not sufficient: a global mapping would have the same identity.
+     * This is set only after the root helper has verified namespace isolation in this process.
+     */
+    private static volatile boolean sRootSafetyVerified;
+
+    private SecondaryUserPrefixManager() {}
+
+    public static final class Inspection {
+        public final boolean secondaryUser;
+        public final boolean ready;
+        public final int userId;
+        public final String actualFilesPath;
+        public final String summary;
+        public final String diagnostics;
+
+        private Inspection(boolean secondaryUser, boolean ready, int userId,
+                           String actualFilesPath, String summary, String diagnostics) {
+            this.secondaryUser = secondaryUser;
+            this.ready = ready;
+            this.userId = userId;
+            this.actualFilesPath = actualFilesPath;
+            this.summary = summary;
+            this.diagnostics = diagnostics;
+        }
+    }
+
+    public static final class SetupResult {
+        public final boolean success;
+        public final String summary;
+        public final String diagnostics;
+
+        private SetupResult(boolean success, String summary, String diagnostics) {
+            this.success = success;
+            this.summary = summary;
+            this.diagnostics = diagnostics;
+        }
+    }
+
+    public static Inspection inspect(Context context) {
+        int appUid = Process.myUid();
+        int userId = appUid / ANDROID_UIDS_PER_USER;
+        String diagnostics =
+            "Termux version: " + BuildConfig.VERSION_NAME +
+            "\nProcess UID: " + appUid +
+            "\nAndroid user: " + userId +
+            "\nProcess PID: " + Process.myPid() + "\n";
+
+        if (!TermuxConstants.TERMUX_PACKAGE_NAME.equals(context.getPackageName()) ||
+            !BuildConfig.APPLICATION_ID.equals(context.getPackageName())) {
+            return new Inspection(userId != 0, false, userId, null,
+                "Unexpected application package",
+                diagnostics + "Package: " + context.getPackageName() +
+                    "\nExpected: " + TermuxConstants.TERMUX_PACKAGE_NAME);
+        }
+
+        if (userId == 0) {
+            return new Inspection(false, true, 0, null,
+                "Primary Android user; no mapping required", diagnostics + "Mapping: bypassed");
+        }
+
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+            UserManager userManager = (UserManager) context.getSystemService(Context.USER_SERVICE);
+            if (userManager == null || !userManager.isUserUnlocked()) {
+                return new Inspection(true, false, userId, null,
+                    "The secondary user must be unlocked",
+                    diagnostics + "User unlocked: false\nUnlock this Android user and retry.");
+            }
+        }
+
+        File filesDir = context.getFilesDir();
+        if (filesDir == null) {
+            return new Inspection(true, false, userId, null,
+                "Android did not provide the app files directory",
+                diagnostics + "Files directory: null");
+        }
+
+        String actualFilesPath = filesDir.getAbsolutePath();
+        String expectedFilesPath = "/data/user/" + userId + "/com.termux/files";
+        if (!expectedFilesPath.equals(actualFilesPath)) {
+            return new Inspection(true, false, userId, actualFilesPath,
+                "Unsupported app-data path",
+                diagnostics + "Actual files path: " + actualFilesPath +
+                    "\nExpected: " + expectedFilesPath + "\nNo mount was attempted.");
+        }
+
+        try {
+            StructStat actualStat = Os.stat(actualFilesPath);
+            if (!OsConstants.S_ISDIR(actualStat.st_mode) || actualStat.st_uid != appUid ||
+                !filesDir.canRead() || !filesDir.canWrite() || !filesDir.canExecute()) {
+                return new Inspection(true, false, userId, actualFilesPath,
+                    "The secondary-user files directory failed ownership or access checks",
+                    diagnostics + "Actual files path: " + actualFilesPath +
+                        "\nOwner UID: " + actualStat.st_uid +
+                        "\nExpected UID: " + appUid +
+                        "\nDirectory: " + OsConstants.S_ISDIR(actualStat.st_mode) +
+                        "\nReadable/writable/searchable: " + filesDir.canRead() + "/" +
+                        filesDir.canWrite() + "/" + filesDir.canExecute());
+            }
+
+            try {
+                File hardcodedFilesDir = new File("/data/data/com.termux/files");
+                StructStat hardcodedStat = Os.stat(hardcodedFilesDir.getAbsolutePath());
+                boolean identityMatches = actualStat.st_dev == hardcodedStat.st_dev &&
+                    actualStat.st_ino == hardcodedStat.st_ino;
+                boolean mappedPathAccessible = identityMatches && hardcodedStat.st_uid == appUid &&
+                    OsConstants.S_ISDIR(hardcodedStat.st_mode) && hardcodedFilesDir.canRead() &&
+                    hardcodedFilesDir.canWrite() && hardcodedFilesDir.canExecute();
+
+                if (mappedPathAccessible && sRootSafetyVerified) {
+                    return new Inspection(true, true, userId, actualFilesPath,
+                        "Secondary-user prefix mapping verified",
+                        diagnostics + "Actual files path: " + actualFilesPath +
+                            "\nHardcoded files path: /data/data/com.termux/files" +
+                            "\nIdentity check: same device and inode\nMapping: ready");
+                }
+
+                String summary = mappedPathAccessible
+                    ? "The path identity is correct, but namespace safety is not verified"
+                    : "The Termux hardcoded path is not mapped to this user";
+                return new Inspection(true, false, userId, actualFilesPath, summary,
+                    diagnostics + "Actual files path: " + actualFilesPath +
+                        "\nHardcoded files path: /data/data/com.termux/files" +
+                        "\nIdentity check: " + (identityMatches ? "match" : "mismatch") +
+                        "\nNamespace safety: " +
+                        (sRootSafetyVerified ? "verified" : "not verified") +
+                        "\nMapping: required");
+            } catch (ErrnoException e) {
+                return new Inspection(true, false, userId, actualFilesPath,
+                    "The Termux hardcoded path is not accessible yet",
+                    diagnostics + "Actual files path: " + actualFilesPath +
+                        "\nHardcoded files path: /data/data/com.termux/files" +
+                        "\nAlias stat errno: " + e.errno + "\nMapping: required");
+            }
+        } catch (ErrnoException e) {
+            return new Inspection(true, false, userId, actualFilesPath,
+                "Cannot inspect the secondary-user files directory",
+                diagnostics + "Actual files path: " + actualFilesPath +
+                    "\nstat errno: " + e.errno);
+        }
+    }
+
+    public static boolean isReadyForTermux(Context context) {
+        return inspect(context).ready;
+    }
+
+    public static SetupResult setup(Context context) {
+        Inspection before = inspect(context);
+        if (before.ready) {
+            return new SetupResult(true, before.summary, before.diagnostics);
+        }
+        if (!before.secondaryUser || before.actualFilesPath == null) {
+            return new SetupResult(false, before.summary, before.diagnostics);
+        }
+        String expectedFilesPath =
+            "/data/user/" + before.userId + "/com.termux/files";
+        if (!expectedFilesPath.equals(before.actualFilesPath)) {
+            return new SetupResult(false, before.summary, before.diagnostics);
+        }
+
+        java.lang.Process rootProcess = null;
+        try {
+            ProcessBuilder builder = new ProcessBuilder(findSuCommand(), "-t",
+                String.valueOf(Process.myPid()), "-c",
+                buildRootScript(before.userId, Process.myUid(), Process.myPid()));
+            builder.redirectErrorStream(true);
+            builder.environment().put("PATH", "/system/bin:/system/xbin");
+            rootProcess = builder.start();
+
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(ROOT_HELPER_TIMEOUT_SECONDS);
+            while (true) {
+                try {
+                    int exitCode = rootProcess.exitValue();
+                    String helperOutput = readLimited(rootProcess.getInputStream());
+                    if (exitCode == 0) sRootSafetyVerified = true;
+
+                    Inspection after = inspect(context);
+                    if (!after.ready) sRootSafetyVerified = false;
+
+                    String diagnostics = before.diagnostics + "\n\nRoot helper output:\n" +
+                        (helperOutput.isEmpty() ? "(none)" : helperOutput.trim()) +
+                        "\n\nPost-check:\n" + after.diagnostics;
+                    if (exitCode != 0) {
+                        return new SetupResult(false, explainRootFailure(exitCode),
+                            diagnostics + "\nRoot helper exit code: " + exitCode);
+                    }
+                    if (!after.ready) {
+                        return new SetupResult(false,
+                            "Root helper finished, but the app-side identity check failed",
+                            diagnostics);
+                    }
+                    return new SetupResult(true,
+                        "Secondary-user prefix mapping verified", diagnostics);
+                } catch (IllegalThreadStateException ignored) {
+                    if (System.nanoTime() >= deadline) {
+                        rootProcess.destroy();
+                        return new SetupResult(false, "Timed out waiting for Magisk",
+                            before.diagnostics +
+                                "\nRoot helper: timed out after 90 seconds");
+                    }
+                    Thread.sleep(100L);
+                }
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            if (rootProcess != null) rootProcess.destroy();
+            return new SetupResult(false, "Setup was interrupted",
+                before.diagnostics + "\nRoot helper: interrupted");
+        } catch (Exception e) {
+            if (rootProcess != null) rootProcess.destroy();
+            return new SetupResult(false, "Unable to start Magisk su",
+                before.diagnostics + "\nRoot helper error: " + e.getClass().getSimpleName() +
+                    (e.getMessage() == null ? "" : ": " + e.getMessage()));
+        }
+    }
+
+    private static String findSuCommand() {
+        File systemSu = new File("/system/bin/su");
+        if (systemSu.canExecute()) return systemSu.getAbsolutePath();
+        File systemXbinSu = new File("/system/xbin/su");
+        return systemXbinSu.canExecute() ? systemXbinSu.getAbsolutePath() : "su";
+    }
+
+    static String buildRootScript(int userId, int appUid, int appPid) {
+        if (userId <= 0 || appUid <= 0 || appPid <= 0 ||
+            appUid / ANDROID_UIDS_PER_USER != userId) {
+            throw new IllegalArgumentException("Invalid secondary-user process identity");
+        }
+        return "PATH=/system/bin:/system/xbin\n" +
+            "USER_ID=" + userId + "\n" +
+            "APP_UID=" + appUid + "\n" +
+            "APP_PID=" + appPid + "\n" +
+            "SOURCE_ROOT=/data/user/$USER_ID\n" +
+            "SOURCE_FILES=$SOURCE_ROOT/com.termux/files\n" +
+            "TARGET_ROOT=/data/data\n" +
+            "TARGET_FILES=$TARGET_ROOT/com.termux/files\n" +
+            "fail() { echo \"POC_ERROR:$1\"; exit \"$2\"; }\n" +
+            "cleanup_fail() { /system/bin/umount \"$TARGET_ROOT\" >/dev/null 2>&1; echo \"POC_ERROR:$1\"; exit \"$2\"; }\n" +
+            "[ \"$(/system/bin/id -u)\" = 0 ] || fail not-root 20\n" +
+            "[ -d \"$SOURCE_FILES\" ] || fail source-files-missing 21\n" +
+            "SOURCE_UID=$(/system/bin/stat -c %u \"$SOURCE_FILES\" 2>/dev/null) || fail source-stat-failed 22\n" +
+            "[ \"$SOURCE_UID\" = \"$APP_UID\" ] || fail source-owner-mismatch 23\n" +
+            "SELF_NS=$(/system/bin/readlink /proc/self/ns/mnt) || fail self-namespace-unreadable 24\n" +
+            "APP_NS=$(/system/bin/readlink /proc/$APP_PID/ns/mnt) || fail app-namespace-unreadable 25\n" +
+            "INIT_NS=$(/system/bin/readlink /proc/1/ns/mnt) || fail init-namespace-unreadable 26\n" +
+            "echo \"namespace self=$SELF_NS app=$APP_NS init=$INIT_NS\"\n" +
+            "[ \"$SELF_NS\" = \"$APP_NS\" ] || fail su-did-not-enter-app-namespace 27\n" +
+            "[ \"$SELF_NS\" != \"$INIT_NS\" ] || fail app-shares-init-namespace 28\n" +
+            "DATA_MOUNT=$(/system/bin/grep ' /data ' /proc/self/mountinfo | /system/bin/tail -n 1)\n" +
+            "[ -n \"$DATA_MOUNT\" ] || fail data-mount-not-found 29\n" +
+            "case \"$DATA_MOUNT\" in *\" shared:\"*) fail data-mount-is-shared 30;; esac\n" +
+            "INIT_BEFORE=$(/system/bin/grep ' /data/data ' /proc/1/mountinfo | /system/bin/tail -n 1)\n" +
+            "TARGET_BEFORE=$(/system/bin/grep ' /data/data ' /proc/self/mountinfo | /system/bin/tail -n 1)\n" +
+            "case \"$TARGET_BEFORE\" in *\" shared:\"*) fail target-was-shared 43;; esac\n" +
+            "SOURCE_ID=$(/system/bin/stat -c %d:%i \"$SOURCE_FILES\" 2>/dev/null) || fail source-identity-failed 31\n" +
+            "TARGET_ID=$(/system/bin/stat -c %d:%i \"$TARGET_FILES\" 2>/dev/null)\n" +
+            "INIT_TARGET_ID=$(/system/bin/stat -c %d:%i /proc/1/root/data/data/com.termux/files 2>/dev/null)\n" +
+            "if [ \"$SOURCE_ID\" = \"$TARGET_ID\" ]; then\n" +
+            "  EXISTING_TARGET_MOUNT=$(/system/bin/grep ' /data/data ' /proc/self/mountinfo | /system/bin/tail -n 1)\n" +
+            "  [ -n \"$EXISTING_TARGET_MOUNT\" ] || fail existing-target-mount-not-found 40\n" +
+            "  case \"$EXISTING_TARGET_MOUNT\" in *\" shared:\"*) fail existing-target-mount-is-shared 41;; esac\n" +
+            "  [ \"$SOURCE_ID\" != \"$INIT_TARGET_ID\" ] || fail mapping-visible-in-init-namespace 42\n" +
+            "  echo mapping=already-present; exit 0\n" +
+            "fi\n" +
+            "/system/bin/mount -o bind \"$SOURCE_ROOT\" \"$TARGET_ROOT\" || fail bind-mount-failed 32\n" +
+            "TARGET_MOUNT=$(/system/bin/grep ' /data/data ' /proc/self/mountinfo | /system/bin/tail -n 1)\n" +
+            "[ -n \"$TARGET_MOUNT\" ] || cleanup_fail target-mount-not-found 33\n" +
+            "case \"$TARGET_MOUNT\" in *\" shared:\"*) cleanup_fail target-mount-is-shared 34;; esac\n" +
+            "INIT_AFTER=$(/system/bin/grep ' /data/data ' /proc/1/mountinfo | /system/bin/tail -n 1)\n" +
+            "[ \"$INIT_BEFORE\" = \"$INIT_AFTER\" ] || cleanup_fail init-namespace-changed 35\n" +
+            "INIT_TARGET_AFTER_ID=$(/system/bin/stat -c %d:%i /proc/1/root/data/data/com.termux/files 2>/dev/null)\n" +
+            "[ \"$SOURCE_ID\" != \"$INIT_TARGET_AFTER_ID\" ] || cleanup_fail mapping-visible-in-init-namespace 42\n" +
+            "MAPPED_ID=$(/system/bin/stat -c %d:%i \"$TARGET_FILES\" 2>/dev/null) || cleanup_fail mapped-identity-failed 36\n" +
+            "MAPPED_UID=$(/system/bin/stat -c %u \"$TARGET_FILES\" 2>/dev/null) || cleanup_fail mapped-owner-stat-failed 37\n" +
+            "[ \"$SOURCE_ID\" = \"$MAPPED_ID\" ] || cleanup_fail mapped-identity-mismatch 38\n" +
+            "[ \"$MAPPED_UID\" = \"$APP_UID\" ] || cleanup_fail mapped-owner-mismatch 39\n" +
+            "echo mapping=verified\n" +
+            "exit 0\n";
+    }
+
+    private static String explainRootFailure(int exitCode) {
+        switch (exitCode) {
+            case 1:
+                return "Magisk denied or could not complete the root request";
+            case 20:
+                return "Magisk did not grant root";
+            case 27:
+                return "Set Magisk Settings > Mount namespace mode to Inherit namespace, then retry";
+            case 28:
+                return "Termux does not have a private mount namespace on this build";
+            case 30:
+            case 34:
+            case 41:
+            case 43:
+                return "The mount would not be process-local, so setup was refused";
+            case 32:
+                return "The process-local bind mount was rejected";
+            case 35:
+                return "The global mount namespace changed, so setup was rolled back";
+            case 42:
+                return "The mapping was visible globally, so setup was refused";
+            default:
+                return "The secondary-user prefix setup failed safely";
+        }
+    }
+
+    private static String readLimited(InputStream inputStream) throws Exception {
+        ByteArrayOutputStream output = new ByteArrayOutputStream();
+        byte[] buffer = new byte[1024];
+        int total = 0;
+        int count;
+        while (total < MAX_HELPER_OUTPUT_BYTES &&
+            (count = inputStream.read(buffer, 0,
+                Math.min(buffer.length, MAX_HELPER_OUTPUT_BYTES - total))) >= 0) {
+            output.write(buffer, 0, count);
+            total += count;
+        }
+        return new String(output.toByteArray(), StandardCharsets.UTF_8);
+    }
+}
