+package com.termux.app;
+
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Process;
+import android.text.method.ScrollingMovementMethod;
+import android.view.View;
+import android.widget.Button;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AppCompatActivity;
+
+import com.termux.R;
+import com.termux.shared.models.errors.Error;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+
+/** Root-gated setup screen shown before Termux touches its hardcoded prefix paths. */
+public final class SecondaryUserSetupActivity extends AppCompatActivity {
+
+    private static final String EXTRA_ORIGINAL_INTENT =
+        "com.termux.app.extra.SECONDARY_USER_ORIGINAL_INTENT";
+
+    private final ExecutorService mExecutor = Executors.newSingleThreadExecutor();
+
+    private LinearLayout mButtonBar;
+    private TextView mDiagnosticsView;
+    private ProgressBar mProgressBar;
+    private Button mRetryButton;
+    private Future<?> mSetupFuture;
+    private volatile boolean mDestroyed;
+    private boolean mSetupRunning;
+    private TextView mStatusView;
+    private TextView mTitleView;
+    private String mDiagnostics = "";
+
+    public static Intent createIntent(Context context, Intent originalIntent) {
+        Intent intent = new Intent(context, SecondaryUserSetupActivity.class);
+        if (originalIntent != null) {
+            intent.putExtra(EXTRA_ORIGINAL_INTENT, new Intent(originalIntent));
+        }
+        return intent;
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(createContentView());
+        runSetup();
+    }
+
+    private View createContentView() {
+        ScrollView scrollView = new ScrollView(this);
+        scrollView.setFillViewport(true);
+        scrollView.setBackgroundColor(Color.BLACK);
+
+        LinearLayout content = new LinearLayout(this);
+        content.setOrientation(LinearLayout.VERTICAL);
+        content.setGravity(android.view.Gravity.CENTER_HORIZONTAL);
+        int horizontalPadding = dp(24);
+        content.setPadding(horizontalPadding, dp(40), horizontalPadding, horizontalPadding);
+        scrollView.addView(content, new FrameLayout.LayoutParams(
+            FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT));
+
+        mTitleView = new TextView(this);
+        mTitleView.setText(R.string.secondary_user_setup_title);
+        mTitleView.setTextColor(Color.WHITE);
+        mTitleView.setTextSize(23f);
+        mTitleView.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
+        mTitleView.setGravity(android.view.Gravity.CENTER);
+        content.addView(mTitleView, matchWrap());
+
+        mProgressBar = new ProgressBar(this);
+        LinearLayout.LayoutParams progressParams =
+            new LinearLayout.LayoutParams(dp(48), dp(48));
+        progressParams.setMargins(0, dp(28), 0, dp(24));
+        content.addView(mProgressBar, progressParams);
+
+        mStatusView = new TextView(this);
+        mStatusView.setTextColor(Color.LTGRAY);
+        mStatusView.setTextSize(16f);
+        mStatusView.setGravity(android.view.Gravity.CENTER);
+        mStatusView.setLineSpacing(0f, 1.15f);
+        content.addView(mStatusView, matchWrap());
+
+        mDiagnosticsView = new TextView(this);
+        mDiagnosticsView.setTextColor(Color.rgb(220, 220, 220));
+        mDiagnosticsView.setBackgroundColor(Color.rgb(30, 30, 30));
+        mDiagnosticsView.setTypeface(Typeface.MONOSPACE);
+        mDiagnosticsView.setTextSize(12f);
+        mDiagnosticsView.setTextIsSelectable(true);
+        mDiagnosticsView.setMovementMethod(new ScrollingMovementMethod());
+        mDiagnosticsView.setPadding(dp(12), dp(12), dp(12), dp(12));
+        mDiagnosticsView.setVisibility(View.GONE);
+        LinearLayout.LayoutParams diagnosticsParams = matchWrap();
+        diagnosticsParams.setMargins(0, dp(24), 0, 0);
+        content.addView(mDiagnosticsView, diagnosticsParams);
+
+        mButtonBar = new LinearLayout(this);
+        mButtonBar.setOrientation(LinearLayout.VERTICAL);
+        mButtonBar.setVisibility(View.GONE);
+        LinearLayout.LayoutParams buttonsParams = matchWrap();
+        buttonsParams.setMargins(0, dp(20), 0, 0);
+        content.addView(mButtonBar, buttonsParams);
+
+        mRetryButton = addButton(R.string.secondary_user_setup_retry, view -> runSetup());
+        addButton(R.string.secondary_user_setup_copy_diagnostics, view -> copyDiagnostics());
+        addButton(R.string.secondary_user_setup_exit, view -> exitAndEndProcess());
+
+        return scrollView;
+    }
+
+    private Button addButton(int textResource, View.OnClickListener listener) {
+        Button button = new Button(this);
+        button.setText(textResource);
+        button.setOnClickListener(listener);
+        LinearLayout.LayoutParams params = matchWrap();
+        params.setMargins(0, dp(4), 0, dp(4));
+        mButtonBar.addView(button, params);
+        return button;
+    }
+
+    private void runSetup() {
+        if (mSetupRunning || mDestroyed) return;
+
+        mSetupRunning = true;
+        mProgressBar.setVisibility(View.VISIBLE);
+        mButtonBar.setVisibility(View.GONE);
+        mDiagnosticsView.setVisibility(View.GONE);
+
+        SecondaryUserPrefixManager.Inspection inspection =
+            SecondaryUserPrefixManager.inspect(this);
+        mTitleView.setText(R.string.secondary_user_setup_title);
+        mStatusView.setText(getString(R.string.secondary_user_setup_body, inspection.userId));
+
+        mSetupFuture = mExecutor.submit(() -> {
+            SecondaryUserPrefixManager.SetupResult result =
+                SecondaryUserPrefixManager.setup(getApplicationContext());
+            boolean success = result.success;
+            String summary = result.summary;
+            String diagnostics = result.diagnostics;
+
+            if (success) {
+                Error error = TermuxApplication.completeSecondaryUserPrefixSetup(
+                    getApplicationContext());
+                if (error != null) {
+                    diagnostics += "\n\nTermux initialization:\n" +
+                        Error.getMinimalErrorString(error);
+                    success = false;
+                    summary = "The mapping succeeded, but Termux initialization failed";
+                }
+            }
+
+            final boolean finalSuccess = success;
+            final String finalSummary = summary;
+            final String finalDiagnostics = diagnostics;
+            runOnUiThread(() -> finishSetup(
+                finalSuccess, finalSummary, finalDiagnostics));
+        });
+    }
+
+    private void finishSetup(boolean success, String summary, String diagnostics) {
+        if (mDestroyed) return;
+
+        mSetupRunning = false;
+        mDiagnostics = diagnostics == null ? "" : diagnostics;
+        if (success) {
+            mTitleView.setText(R.string.secondary_user_setup_success_title);
+            mStatusView.setText(R.string.secondary_user_setup_success_body);
+            mProgressBar.setVisibility(View.GONE);
+            new Handler(Looper.getMainLooper()).postDelayed(this::launchTermux, 250L);
+            return;
+        }
+
+        mTitleView.setText(R.string.secondary_user_setup_failure_title);
+        mStatusView.setText(summary);
+        mProgressBar.setVisibility(View.GONE);
+        mDiagnosticsView.setText(mDiagnostics);
+        mDiagnosticsView.setVisibility(View.VISIBLE);
+        mButtonBar.setVisibility(View.VISIBLE);
+        mRetryButton.requestFocus();
+    }
+
+    private void launchTermux() {
+        if (mDestroyed || isFinishing()) return;
+
+        Intent original = getIntent().getParcelableExtra(EXTRA_ORIGINAL_INTENT);
+        Intent intent = original == null ? new Intent() : new Intent(original);
+        intent.setClass(this, TermuxActivity.class);
+        intent.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_SINGLE_TOP);
+        startActivity(intent);
+        finish();
+    }
+
+    private void copyDiagnostics() {
+        ClipboardManager clipboard =
+            (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
+        if (clipboard == null) return;
+
+        clipboard.setPrimaryClip(ClipData.newPlainText(
+            "Termux secondary-user setup", mDiagnostics));
+        Toast.makeText(this, R.string.secondary_user_setup_diagnostics_copied,
+            Toast.LENGTH_SHORT).show();
+    }
+
+    private void exitAndEndProcess() {
+        mDestroyed = true;
+        if (mSetupFuture != null) mSetupFuture.cancel(true);
+        finishAndRemoveTask();
+        new Handler(Looper.getMainLooper()).postDelayed(
+            () -> Process.killProcess(Process.myPid()), 150L);
+    }
+
+    @Override
+    public void onBackPressed() {
+        exitAndEndProcess();
+    }
+
+    @Override
+    protected void onDestroy() {
+        mDestroyed = true;
+        if (mSetupFuture != null && !mSetupFuture.isDone()) {
+            mSetupFuture.cancel(true);
+        }
+        mExecutor.shutdownNow();
+        super.onDestroy();
+    }
+
+    private LinearLayout.LayoutParams matchWrap() {
+        return new LinearLayout.LayoutParams(
+            LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+}
